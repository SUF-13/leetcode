class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        vector<vector<int>> ans;

        // sort the array
        sort(nums.begin(), nums.end());

        for(int i=0; i<nums.size(); i++){
            // if at any index the value is greater than zero, then the sum can never be zero, since the array is sorted.
            if(nums[i]>0){
                break;
            }

            // if same value found to avoid the same pair occurence skip
            if((i>0) && (nums[i] == nums [i-1])){
                continue;
            }

            // using 2 pointer approach
            int left = i+1;
            int right = nums.size()-1;

            while(left<right){
                int sum = nums[i]+nums[left]+nums[right];
                if(sum == 0){
                    ans.push_back({nums[i], nums[left], nums[right]});

                    left++;
                    right--;
                    // skip if duplicate element
                    while(left<right && nums[left]==nums[left-1]){
                        left++;
                    }
                    // skip if duplicate element
                    while(left<right && nums[right]==nums[right+1]){
                        right--;
                    }
                }
                // if sum is less than zero , move the left pointer to the right
                else if(sum<0){
                    left++;
                }
                //  sum > 0 move the right pointer to the left
                else{
                    right--;
                }
            }
        }

        return ans;
    }
};
