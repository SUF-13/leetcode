class Solution {
public:
    int minPairSum(vector<int>& nums) {
    
        // sorted the array so that minimum values in start and maximum values in end
        sort(nums.begin(), nums.end());

        int l=0;
        int r=nums.size()-1;
        int maximum=0;
        while(l<r){
            // pair one minimum value with one maximum value
            maximum = max(nums[l]+nums[r], maximum);
            l++;
            r--;
        }


        return maximum;
    }
};
