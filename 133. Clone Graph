class Solution {
public:

    Node* dfs(Node* node, unordered_map<Node*, Node*>& vis){
        if(node == NULL){
            return NULL;
        }

        // if a node is already visited only return the node, so it can be added as a neighbor.
        if(vis.find(node)!=vis.end()){
            return vis[node];
        }

        Node* clone = new Node(node->val);
        vis[node] = clone;

        // recursivley add neighbors
        for(int i=0;i<node->neighbors.size();i++){
            clone->neighbors.push_back(dfs(node->neighbors[i], vis));
        }

        return clone;
    }

    Node* cloneGraph(Node* node) {

        unordered_map<Node*, Node*> visited;
        
        return dfs(node, visited);
    }
};
