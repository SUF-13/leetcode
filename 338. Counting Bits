class Solution {
public:
    vector<int> countBits(int n) {
        vector<int> ans;
        for(int i=0;i<=n;i++){
            int num = i;
            int rem;
            int count=0;
            if(num == 0){
                ans.push_back(0);
                continue;
            }
            while(num>0){
                rem = num%2;
                if(rem==1){
                    count++;
                }
                num = num/2;
            }
            ans.push_back(count);
        }
        return ans;
    }
};
