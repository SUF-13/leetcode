/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* swapPairs(ListNode* head) {

        ListNode* curr = head;
        ListNode dummy;
        dummy.next = head;
        ListNode* prev = &dummy;

        while(curr!=NULL && curr->next!=NULL){
            ListNode* nxt = curr->next;

            // swap
            prev->next = nxt;
            curr->next = nxt->next;
            nxt->next = curr;

            // move to next pair
            prev = curr;
            curr = curr->next;
        }

        return dummy.next;
    }
};
