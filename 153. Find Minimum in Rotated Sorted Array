class Solution {
public:
    int findMin(vector<int>& nums) {

        int l=0;
        int r=nums.size()-1;

        while(l<r){
            // already sorted
            if(nums[l]<nums[r]){
                return nums[l];
            }
            // find mid
            int mid = l + (r-l)/2;

            // if the value at mid is greater or equal to the value at right, means search the right side
            if(nums[mid]>=nums[r]){
                l = mid + 1;
            }
            // else if the value at mid is less than the value at right , means search the left side
            else if (nums[mid]<nums[r]){
                r = mid;
            }

            
        }

        return nums[l];
    }
};
