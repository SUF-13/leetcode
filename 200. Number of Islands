class Solution {
public:
    void dfs(vector<vector<char>>& grid, vector<vector<bool>>& vis, int i, int j, int m, int n){
        if(i<0 || i>=m || j<0 || j>=n || vis[i][j] || grid[i][j] != '1'){
            return;
        }
        vis[i][j] = true;
        dfs(grid, vis, i-1, j, m, n);
        dfs(grid, vis, i, j+1, m, n);
        dfs(grid, vis, i, j-1, m, n);
        dfs(grid, vis, i+1, j, m, n);
    }

    int numIslands(vector<vector<char>>& grid) {
        // treat the 2d grid as graph, and perform depth first search
        vector<vector<bool>> vis(grid.size(), vector<bool> (grid[0].size(),false));
        int m=grid.size();
        int islands=0;
        for(int i=0;i<grid.size();i++){
            for(int j=0;j<grid[i].size();j++){
                int n = grid[i].size();
                if(grid[i][j]=='1' && !vis[i][j]){
                    dfs(grid, vis, i, j, m, n);
                    islands++;
                }
            }
        }
        return islands;
    }
};
