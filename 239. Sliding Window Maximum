class Solution {
public:

    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        vector<int> ans;
        deque<int> dq;

        for(int i=0;i<nums.size();i++){
            // checking the element indices present in the queue are of current window, if not remove them.
            while(!dq.empty() && dq.front()<=(i-k)){
                dq.pop_front();
            }
            // inserting element indices from the back of the queue in a way, if the queue back element value is less than the what we are going to store then remove the back element.
            while(!dq.empty() && nums[dq.back()]<nums[i]){
                dq.pop_back();
            }
            // pushing the indices, as window in queue is being maintain on the indices value.
            dq.push_back(i);

            // pushing the queue front into answer, since the maximum for each window is maintained at front.
            if(i>=(k-1)){
                ans.push_back(nums[dq.front()]);
            }
        }

        return ans;
    }
};
