class Solution {
public:
    int get_inverse(int a){
        int result=0;
        int rem;
        while(a!=0){
            rem = a%10;
            a = a/10;

            // checking for overflow before multiplying the result by 10
            if(result > INT_MAX/10 || (result == INT_MAX/10 && rem>7)){
                return 0;
            }

            if(result < INT_MIN/10 || (result == INT_MIN/10 && rem<-8)){
                return 0;
            }

            result = (result * 10) + rem;
        }

        return result;
    }

    int reverse(int x) {
        int x_inv = get_inverse(x);
        return x_inv;
    }
};
