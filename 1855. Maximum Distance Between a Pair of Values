class Solution {
public:
    int maxDistance(vector<int>& nums1, vector<int>& nums2) {
        
        int i=0,j=0;

        while(i<nums1.size() && j<nums2.size()){
            
            if(nums1[i]>nums2[j]){
                i++; // to satisfy the condition nums1[i]<=nums2[j]
            }
            j++; // to maximize the distance j - i

        }
        return max(0, j-i-1);
    }
};
