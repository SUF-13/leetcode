class Solution {
public:
    string multiply(string num1, string num2) {

        if(num1=="0" || num2=="0"){
            return "0";
        }

        int n = num1.size();
        int m = num2.size();

        vector<int> answer(m + n, 0);
        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 0; j--) {
                int n1 = num1[i] - '0'; // converting string to number, alternative stoi function
                int n2 = num2[j] - '0';

                int mul = n1 * n2;
                int sum = mul + answer[i + j + 1]; // adding theh carry with multiplication result

                answer[i + j + 1] = sum % 10; // storing the result LSB
                answer[i + j] += sum / 10;  // storing the MSB as carry
            }
        }

        string ans = "";

        for (int dig : answer) {
            // skipping the extra zeros in the start of the integer array.
            if (ans.empty() && dig == 0) {
                continue;
            }
            ans += (char)(dig + '0'); // integer to character conversion , alternative to_string function
        }

        return ans;
    }
};
