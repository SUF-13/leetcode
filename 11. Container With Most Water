class Solution {
public:
    int maxArea(vector<int>& height) {
        // brute force approach
        // int maxamt=0;
        // int left=0;
        // int right=0;
        // int intermediate;

        // for(int i=0;i<height.size();i++){
        //     left = height[i];
        //     for(int j=i+1; j<height.size();j++){
        //         right = height[j];
        //         intermediate = min(left,right)*abs(i-j);
        //         maxamt = max(maxamt, intermediate);
        //     }
        // }
        // return maxamt;

        int left = 0;
        int right = height.size()-1;
        int intermediate;
        int maxamt=0;

        while(left<right){
            intermediate = abs(left-right)*min(height[left],height[right]);
            maxamt = max(intermediate, maxamt);
            if(height[left]<=height[right]){
                left++;
            }
            else{
                right--;
            }
        }
        return maxamt;

    }
};
