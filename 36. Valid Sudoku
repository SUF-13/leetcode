class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {

        // check rows
        for(int i=0;i<board.size();i++){
            int hash[10]={0};

            for(int j=0;j<board[i].size();j++){ 
                int num = board[i][j] -'0';
                if(board[i][j] == '.'){
                    continue;
                }
                hash[num]++;

                if(hash[num]>1){
                    return false;
                }
            }
        }

        // check columns
        for(int i=0;i<board[i].size();i++){
            int hash[10]={0};
            for(int j=0;j<board.size();j++){
                int num=board[j][i] - '0';
                if(board[j][i] == '.'){
                    continue;
                }

                hash[num]++;

                if(hash[num]>1){
                    return false;
                }
            }
        }

        vector<pair<int,int>> indexes = {{0,0}, {0,3}, {0,6},
                                        {3,0}, {3,3}, {3,6},
                                        {6,0}, {6,3}, {6,6}};


        // check boxes
        for(int i=0;i<indexes.size();i++){
            int hash[10]={0};
            for(int j=indexes[i].first;j<(indexes[i].first+3);j++){
                for(int k=indexes[i].second;k<(indexes[i].second+3);k++){
                    int num = board[j][k] - '0';
                    if(board[j][k] == '.'){
                        continue;
                    }
                    hash[num]++;
                    if(hash[num]>1){
                        return false;
                    }
                }
            }
        }
        


        return true;
    }
};
