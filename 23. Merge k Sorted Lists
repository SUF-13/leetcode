/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeKLists(vector<ListNode*>& lists) {
        int k = lists.size();
        ListNode dummy(0);
        ListNode* head = &dummy;
        
        while(true){
            int min_index = -1;

            // find the minmum valued head from the vector of lists
            for(int i=0;i<k;i++){
                if((lists[i]!=NULL) && (min_index == -1 || lists[i]->val<lists[min_index]->val)){
                    min_index = i;
                }
            }

            if(min_index == -1){
                break;
            }

            // preserve the list head, move the list to its next element.
            ListNode* curr = lists[min_index];
            lists[min_index] = lists[min_index]->next;

            // attach the preserved head (of list) into the merged list start, and move forward, so it can correctly attach the other nodes in its front(right)
            head->next = curr;
            head = head->next;
        }
        
        return dummy.next;
    }
};
